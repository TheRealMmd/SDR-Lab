- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\nimport json\nfrom datetime import datetime, timezone\nfrom pathlib\
      \ import Path\n\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"SDR Lab IQ Recorder\"\"\"\n\n    def __init__(\n        self,\n \
      \       fc=945e6,\n        fs=2.6e6,\n        gain=10.0,\n        record=False,\n\
      \        max_seconds=10.0,\n    ):\n        gr.sync_block.__init__(\n      \
      \      self,\n            name=\"SDR Lab IQ Recorder\",\n            in_sig=[np.complex64],\n\
      \            out_sig=[]\n        )\n\n        # Parameters controlled by GRC\n\
      \        self.fc = fc\n        self.fs = fs\n        self.gain = gain\n    \
      \    self.record = record\n        self.max_seconds = max_seconds\n\n      \
      \  # Recording state\n        self._file = None\n        self._path = None\n\
      \        self._samples_written = 0\n        self._target_samples = 0\n     \
      \   self._armed = True\n        self._metadata = None\n\n    def _start_recording(self):\n\
      \        fs = float(self.fs)\n        duration = float(self.max_seconds)\n\n\
      \        if fs <= 0 or duration <= 0:\n            raise ValueError(\n     \
      \           \"fs and max_seconds must be positive\"\n            )\n\n     \
      \   folder = Path.home() / \"SDR_Lab_Recordings\"\n        folder.mkdir(parents=True,\
      \ exist_ok=True)\n\n        timestamp = datetime.now().strftime(\n         \
      \   \"%Y%m%d_%H%M%S_%f\"\n        )\n        self._path = folder / f\"iq_{timestamp}.c64\"\
      \n\n        self._file = open(self._path, \"wb\")\n        self._samples_written\
      \ = 0\n        self._target_samples = max(\n            1, int(fs * duration)\n\
      \        )\n\n        self._metadata = {\n            \"center_frequency_hz\"\
      : float(self.fc),\n            \"sample_rate_hz\": fs,\n            \"rx_gain_db\"\
      : float(self.gain),\n            \"max_seconds\": duration,\n            \"\
      data_type\": \"complex64\",\n            \"started_utc\": datetime.now(\n  \
      \              timezone.utc\n            ).isoformat(),\n        }\n\n     \
      \   print(\"Recording started:\", self._path)\n\n    def _stop_recording(self,\
      \ reason):\n        if self._file is None:\n            return\n\n        self._file.close()\n\
      \        self._file = None\n\n        self._metadata[\"samples_written\"] =\
      \ (\n            self._samples_written\n        )\n        self._metadata[\"\
      recorded_seconds\"] = (\n            self._samples_written\n            / self._metadata[\"\
      sample_rate_hz\"]\n        )\n        self._metadata[\"stop_reason\"] = reason\n\
      \n        metadata_path = self._path.with_suffix(\n            \".json\"\n \
      \       )\n\n        with open(\n            metadata_path, \"w\", encoding=\"\
      utf-8\"\n        ) as f:\n            json.dump(self._metadata, f, indent=2)\n\
      \n        print(\"Recording saved:\", self._path)\n\n    def work(self, input_items,\
      \ output_items):\n        samples = input_items[0]\n        n = len(samples)\n\
      \n        # Checkbox disabled\n        if not bool(self.record):\n         \
      \   if self._file is not None:\n                self._stop_recording(\"User\
      \ stopped\")\n\n            self._armed = True\n            return n\n\n   \
      \     # Start only once per checkbox activation\n        if self._armed and\
      \ self._file is None:\n            self._start_recording()\n\n        if self._file\
      \ is not None:\n            remaining = (\n                self._target_samples\n\
      \                - self._samples_written\n            )\n            count =\
      \ min(n, remaining)\n\n            if count > 0:\n                self._file.write(\n\
      \                    samples[:count].tobytes()\n                )\n        \
      \        self._samples_written += count\n\n            if (\n              \
      \  self._samples_written\n                >= self._target_samples\n        \
      \    ):\n                self._stop_recording(\n                    \"Maximum\
      \ duration reached\"\n                )\n                self._armed = False\n\
      \n        return n\n\n    def stop(self):\n        self._stop_recording(\"Flowgraph\
      \ stopped\")\n        return True\n"
    affinity: ''
    alias: ''
    comment: ''
    fc: f_tune
    fs: samp_rate
    gain: rf_gain
    max_seconds: rec_sec
    maxoutbuf: '0'
    minoutbuf: '0'
    record: rec
  states:
    _io_cache: ('SDR Lab IQ Recorder', 'blk', [('fc', '945000000.0'), ('fs', '2600000.0'),
      ('gain', '10.0'), ('record', 'False'), ('max_seconds', '10.0')], [('0', 'complex',
      1)], [], 'SDR Lab IQ Recorder', ['fc', 'fs', 'gain', 'max_seconds', 'record'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1384, 500.0]
    rotation: 0
    state: enabled
